# Exynos 8890 (S7/S7E/N7) OneUI 4.1 max-performance fragment
# Target base: hero_defconfig / exynos8890_defconfig.
# NOTE: symbols missing from this tree are kept as TODO/backport markers.

# -----------------------------------------------------------------------------
# 1) Desbloqueio total de núcleos / CPU Boosters
# -----------------------------------------------------------------------------
CONFIG_SCHED_TUNE=y
CONFIG_SCHED_WALT=y
CONFIG_CPU_FREQ_GOV_INTERACTIVE=y
CONFIG_HOTPLUG_CPU=y
# TODO(backport): requested symbols not found in this tree (defconfig will ignore)
# CONFIG_CPU_BOOST is not set
# CONFIG_FINGERPRINT_BOOST is not set
# CONFIG_TOUCHSCREEN_BOOST is not set
# CONFIG_ALLOW_4_CORES_MAX_FREQ is not set
# CONFIG_CPU_FREQ_LIMIT_START_FREQ is not set
# CONFIG_CPU_BOOST_FREQ is not set

# -----------------------------------------------------------------------------
# 2) GPU/Bus performance
# -----------------------------------------------------------------------------
# TODO(backport): requested symbols not found in this tree
# CONFIG_MALI_BIFROST_FOR_SW_DEVELOPER is not set
# CONFIG_MALI_GONDUL_LATE_DVFS is not set
# CONFIG_EXYNOS_DEVFREQ_HIERARCHY is not set

# -----------------------------------------------------------------------------
# 3) Pageboost + RAM/IO
# -----------------------------------------------------------------------------
CONFIG_SAMSUNG_PAGEBOOST=y
CONFIG_PAGEBOOST_IO_BOOST=y
# TODO(backport): requested symbol not found in this tree
# CONFIG_PAGEBOOST_PREFETCH is not set
# CONFIG_SCHED_BOOST is not set
CONFIG_ZRAM=y
CONFIG_ZRAM_LZ4_COMPRESS=y
# CONFIG_ZRAM_WRITEBACK is not set
# CONFIG_CMA_DEBUG is not set
# Keep CMA larger for GPU-heavy use-cases
CONFIG_CMA=y
CONFIG_CMA_SIZE_SEL_MBYTES=y
CONFIG_CMA_SIZE_MBYTES=128

# -----------------------------------------------------------------------------
# 4) Debug/overhead cleanup
# -----------------------------------------------------------------------------
# CONFIG_SEC_DEBUG is not set
# CONFIG_SEC_DEBUG_LAST_KMSG is not set
# CONFIG_KNOX_KAP is not set
# CONFIG_RKP_KDP is not set
# CONFIG_FTRACE is not set
# CONFIG_KPROBES is not set
# CONFIG_PROFILING is not set
# CONFIG_TIMA is not set

# -----------------------------------------------------------------------------
# 5) ASV / OV-UV controls
# -----------------------------------------------------------------------------
# TODO(backport): requested symbols not found in this tree
# CONFIG_EXYNOS_ASV is not set
# CONFIG_EXYNOS_OV_UV is not set
